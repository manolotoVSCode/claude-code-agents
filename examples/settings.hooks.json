{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__db__execute_sql|mcp__db__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guardian-sql.py",
            "args": []
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guardian-merge.py",
            "args": []
          }
        ]
      }
    ]
  }
}
